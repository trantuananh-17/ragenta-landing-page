# Public URLs. Read at RUNTIME (src/lib/public-env.ts), never baked into the
# bundle — the same image runs against any environment.
SITE_URL=http://localhost:3000
APP_URL=http://localhost:3001

# Content backend (ragenta-content-backend). Leave UNSET to serve every page
# from the built-in content source in `src/content/`. Set it and
# `src/content/source.ts` switches to the real HTTP API with no other change.
#
# Server-side only: pages read it through `src/content/*`, and the browser goes
# through this site's own /api/* routes, so the URL never reaches the bundle.
#
# Content is cached for 300s (CONTENT_REVALIDATE_SECONDS, set on the fetch in
# src/content/source.ts), so an edit in the content backend shows up here within
# about five minutes rather than immediately. The window is deliberate — see D-9
# in .claude/docs/DECISIONS.md.
# RAGENTA_CONTENT_API_URL=http://localhost:8084

# Contact form. Unset → the API returns 503 and the form shows an error.
# CONTACT_WEBHOOK_URL=

# Analytics. Unset → PostHog is not loaded at all.
# POSTHOG_KEY=
# POSTHOG_HOST=https://us.i.posthog.com
