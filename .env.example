# Public URLs. Read at RUNTIME (src/lib/public-env.ts), never baked into the
# bundle — the same image runs against any environment.
SITE_URL=http://localhost:3000
APP_URL=http://localhost:3001

# Content backend. Leave UNSET to serve every page from the built-in content
# source in `src/content/` (the current state — no backend exists yet). Set it
# and `src/content/source.ts` switches to the real HTTP API with no other change.
# RAGENTA_CONTENT_API_URL=https://api.ragenta.ai

# Contact form. Unset → the API returns 503 and the form shows an error.
# CONTACT_WEBHOOK_URL=

# Analytics. Unset → PostHog is not loaded at all.
# POSTHOG_KEY=
# POSTHOG_HOST=https://us.i.posthog.com
